# Research data, outputs, logs, and model-status metadata are versioned.
# Downloaded model weights are not.
*.safetensors
*.pt
*.pth
*.bin

# Environments, downloaded reference repository, and runtime caches.
/.venv*/
/runtime/
/safety-eval/
__pycache__/
*.py[cod]
*.tmp
.pytest_cache/
.DS_Store

# Credentials must never enter version control.
.env
.env.*
.gh*/
hosts.yml
*.pem
*.key
